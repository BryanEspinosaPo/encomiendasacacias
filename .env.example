# En Railway: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://usuario:clave@localhost:5432/encomiendas
# Texto largo y aleatorio para firmar las sesiones
JWT_SECRET=cambia-esto-por-un-texto-largo-y-secreto
